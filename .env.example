# Salin menjadi .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# File .env TIDAK boleh di-commit.

# --- App ---
APP_NAME=gin-template
# development | test | production
APP_ENV=development
APP_PORT=8080
SHUTDOWN_TIMEOUT=10s
# debug | info | warn | error
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- HTTP ---
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
# Pisahkan dengan koma. Kosongkan untuk menonaktifkan CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# IP/CIDR reverse proxy yang dipercaya (mis. 10.0.0.0/8). Kosong = tidak ada.
TRUSTED_PROXIES=

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
# disable untuk lokal; require/verify-full untuk production
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
